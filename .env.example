# CardioSurv API — Environment Variables Template


# DATABASE
# Local development (SQLite)
DATABASE_URL=sqlite:///cardiosurv.db

# Production (Render PostgreSQL)
# DATABASE_URL=postgresql://user:password@hostname:5432/cardiosurv

# MODEL PATHS
MODEL_DIR=./models

# CORS (Cross-Origin Resource Sharing)
# Add your production frontend URL here
CORS_ORIGINS=https://cardiosurv-frontend.onrender.com,http://localhost:5500

# SERVER
PORT=10000
ENVIRONMENT=development  # Change to 'production' on Render

# OPTIONAL: Keep-warm ping interval (seconds)
HEALTH_CHECK_INTERVAL=600
