# ============================================================================
# CardioSurv API — Environment Variables Template
# ============================================================================
# Copy this file to `.env` for local dev:    cp .env.example .env
# On Render, set each variable in the dashboard (Service → Environment)
# or via render.yaml (already configured).
# ============================================================================


# ---- DATABASE ---------------------------------------------------------------
# Local development (SQLite — zero-config, file lives at repo root):
DATABASE_URL=sqlite:///cardiosurv.db

# Local Postgres via docker compose:
# DATABASE_URL=postgresql+psycopg2://cardiosurv:cardiosurv@localhost:5432/cardiosurv

# Render Postgres (auto-injected by render.yaml — do NOT hardcode here):
# DATABASE_URL=postgresql://user:password@hostname.singapore-postgres.render.com:5432/cardiosurv


# ---- MODEL PATHS ------------------------------------------------------------
MODEL_DIR=./models
PART1_MODEL_PATH=models/part1_classifier_v1.0.pkl
PART2_MODEL_PATH=models/part2_recommender_v1.0.pkl
SURVIVAL_MODEL_PATH=models/survival_cox_v1.0.pkl
FEATURES_CSV=data/processed/features.csv


# ---- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins for the frontend.
# Use "*" to allow any origin (handy during team integration test phase).
#
# Local dev (Live Server / python -m http.server 5500):
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Production (set to Law Zi Ying's deployed Render Static Site URL):
# CORS_ORIGINS=https://cardiosurv-frontend.onrender.com


# ---- SERVER -----------------------------------------------------------------
PORT=8000
ENVIRONMENT=development     # set to "production" on Render


# ---- KEEP-WARM (Render free tier sleeps after 15 min idle) ------------------
# Used by scripts/keep_warm.py — interval in seconds between health pings.
HEALTH_CHECK_INTERVAL=600
