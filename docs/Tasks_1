def age_bin(age: int) -> str:
    if age < 40:  return "<40"
    if age < 50:  return "40-49"
    if age < 60:  return "50-59"
    if age < 70:  return "60-69"
    return "70+"

def hr_stress_index(max_hr: int, age: int) -> float:
    return round(max_hr / (220 - age), 3)
\end{lstlisting}

